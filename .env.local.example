# 표기: [필수] 반드시 입력, [조건부] 기능 사용 시 입력, [미사용] 이 환경에서는 쓰지 않음

# ---------- Compose 실행 ----------
COMPOSE_PROJECT_NAME=arcade-local
COMPOSE_PROFILES=local

# ---------- 컨테이너 자원 제한 ----------
# [미사용] Nginx는 prod 프로필에서만 실행한다.
NGINX_MEM_LIMIT=128m
REDIS_MAXMEMORY=192mb
REDIS_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=384m
BACKEND_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=256m
CADDY_MEM_LIMIT=64m
# [조건부] monitoring 프로필을 사용할 때만 적용한다.
NGINX_EXPORTER_MEM_LIMIT=64m
NGINX_EXPORTER_GOMEMLIMIT=48MiB
POSTGRES_EXPORTER_MEM_LIMIT=64m
POSTGRES_EXPORTER_GOMEMLIMIT=48MiB

# ---------- PostgreSQL exporter ----------
# [조건부] monitoring 프로필을 사용할 때만 필요하다.
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=postgres_exporter_local

# ---------- 모니터링 ----------
# [조건부] monitoring 또는 grafana 프로필을 사용할 때 적용한다.
METRICS_DOMAIN=metrics.crewon.localhost
PROMETHEUS_EXTERNAL_URL=http://crewon.localhost:8081/prometheus
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=7d
PROMETHEUS_MEM_LIMIT=256m
GRAFANA_MEM_LIMIT=384m
GRAFANA_GOMEMLIMIT=320MiB
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true
PROMETHEUS_URL=http://prometheus:9090/prometheus

# ---------- 경로·포트·프록시 ----------
# 앱만 띄울 때는 8081을 게시하지 않고, monitoring을 추가하면 같은 파일로 8081도 연다.
CADDYFILE=./infra/caddy/Caddyfile.monitoring
MONITORING_HTTP_PORT=8081
DATA_PATH=./data
PUBLISH_HOST=127.0.0.1
HTTP_PORT=80
# [미사용] prod Nginx에서만 사용한다.
HTTPS_PORT=443
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
SITE_ADDR=http://crewon.localhost
# [미사용] 아래 인증서·Basic Auth 파일은 prod Nginx에서만 사용한다.
CERTBOT_WEBROOT=./data/certbot/www
CERTBOT_CONF=./data/certbot/conf
METRICS_HTPASSWD=./data/nginx/metrics.htpasswd
# [미사용] prod Nginx로 모니터링 주소를 공개할 때만 필요하다.
METRICS_BASIC_AUTH_USER=metrics
METRICS_BASIC_AUTH_PASSWORD=metrics-local

# ---------- 애플리케이션 이미지 ----------
# [선택] 이미지를 안 주면 compose 가 arcade-backend:local / arcade-frontend:local 을 쓴다.
# 로컬에서 직접 빌드한 것을 그대로 띄우는 흐름이다.
BACKEND_IMAGE=
FRONTEND_IMAGE=

# ---------- Backend runtime ----------
SPRING_PROFILES_ACTIVE=local
TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
MANAGEMENT_METRICS_TAGS_APPLICATION=back
MANAGEMENT_METRICS_TAGS_ENVIRONMENT=local
MANAGEMENT_METRICS_TAGS_SERVER=arcade-local

# ---------- PostgreSQL container ----------
POSTGRES_DB=arcade
POSTGRES_USER=arcade
POSTGRES_PASSWORD=arcade

# ---------- Spring datasource ----------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/arcade
SPRING_DATASOURCE_USERNAME=arcade
SPRING_DATASOURCE_PASSWORD=arcade
SPRING_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=10
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=30000

# ---------- Redis container and Spring client ----------
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=arcade

# ---------- GitHub OAuth ----------
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_ID=changeme
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_SECRET=changeme

# ---------- Application security ----------
CUSTOM__JWT__SECRET_KEY=changeme-local-jwt-key-with-at-least-64-characters-before-login-use
CUSTOM__ADMIN_ACCOUNT__EMAIL=admin@test.com
CUSTOM__ADMIN_ACCOUNT__PASSWORD=changeme-local-admin-password
CUSTOM__ADMIN_ACCOUNT__NICKNAME=관리자
PUBLIC_ORIGIN=http://crewon.localhost
CUSTOM__ACCESS_TOKEN__EXPIRATION_SECONDS=900

# ---------- 비밀번호·세션 정책 ----------
CUSTOM__PASSWORD__MIN_LENGTH=8
CUSTOM__PASSWORD__MAX_LENGTH=64
CUSTOM__PASSWORD__REQUIRE_LETTER=true
CUSTOM__PASSWORD__REQUIRE_NUMBER=true
CUSTOM__PASSWORD__REQUIRE_SPECIAL_CHARACTER=true
CUSTOM__PASSWORD__ALLOW_WHITESPACE=false
CUSTOM__PASSWORD_RESET__EXPIRATION_SECONDS=1800
CUSTOM__RATE_LIMIT__PASSWORD_RESET_REQUEST__EMAIL_MAX_REQUESTS=3
CUSTOM__RATE_LIMIT__PASSWORD_RESET_REQUEST__IP_MAX_REQUESTS=10
CUSTOM__RATE_LIMIT__PASSWORD_RESET_REQUEST__WINDOW_SECONDS=3600
CUSTOM__SESSION__ACCESS_TOKEN_INVALIDATION=refresh-token-only

# ---------- 추천 큐레이션 ----------
# [조건부] enabled=false면 API key를 사용하지 않는다.
CUSTOM__CURATION__ENABLED=false
CUSTOM__CURATION__MODEL=gemini-3.5-flash-lite
CUSTOM__CURATION__BATCH_CRON=0 5 10 * * *
CUSTOM__CURATION__CANDIDATE_LIMIT=15
CUSTOM__CURATION__GEMINI__API_KEY=

# ---------- GitHub App ----------
# [조건부] GitHub App 연동을 쓸 때만 채운다. 아니면 모두 비워 둔다.
# 값 얻는 법은 docs/github-app.md
CUSTOM__GITHUB__APP__ID=
CUSTOM__GITHUB__APP__SLUG=
CUSTOM__GITHUB__APP__PRIVATE_KEY=
CUSTOM__GITHUB__WEBHOOK__SECRET=

# ---------- GitHub App 사용자 인증 ----------
# [조건부] 위 GitHub App 연동을 쓸 때만 사용한다. 아니면 모두 비워 둔다.
# 로컬은 ngrok 주소가 바뀔 때마다 콜백을 갱신한다.
CUSTOM__GITHUB__APP__CLIENT_ID=
CUSTOM__GITHUB__APP__CLIENT_SECRET=
CUSTOM__GITHUB__APP__USER_AUTHORIZATION_CALLBACK_URL=
CUSTOM__GITHUB__APP__TOKEN_ENCRYPTION_KEY=

# ---------- 파일 저장소 ----------
# local = 서버 디스크(.uploads). MinIO 없이 개발할 때 쓴다.
# [미사용] TYPE=local이면 아래 S3 항목은 모두 쓰지 않는다.
# [조건부] s3로 두고 MinIO를 띄울 때는 S3 항목을 채운다(dev 프로필은 DevS3Config가 받는다).
CUSTOM__STORAGE__TYPE=local
CUSTOM__STORAGE__LOCAL__PATH=.uploads
CUSTOM__STORAGE__S3__ENDPOINT=
CUSTOM__STORAGE__S3__REGION=us-east-1
CUSTOM__STORAGE__S3__BUCKET=
CUSTOM__STORAGE__S3__ACCESS_KEY=
CUSTOM__STORAGE__S3__SECRET_KEY=
# [선택] 비우면 endpoint/bucket으로 URL을 만든다.
CUSTOM__STORAGE__S3__PUBLIC_URL_PREFIX=
CUSTOM__STORAGE__S3__PATH_STYLE_ACCESS=true

# ---------- Logging ----------
LOGGING_LEVEL_COM_BACK=DEBUG
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=TRACE
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_EXTRACT=TRACE
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_TRANSACTION_INTERCEPTOR=TRACE

# ---------- Frontend ----------
# Compose 브라우저 API는 동일 출처 `/api/v1`, SSR은 백엔드를 직접 사용한다.
NEXT_PUBLIC_USE_MOCK=false
API_BASE_URL_INTERNAL=http://backend:8080/api/v1

# ---------- Resend 메일 ----------
# [조건부] enabled=false면 FROM과 API_KEY를 사용하지 않는다.
# 로컬 테스트에서는 Resend 계정에서 허용된 수신 주소와 onboarding@resend.dev를 사용한다.
CUSTOM__MAIL__ENABLED=false
CUSTOM__MAIL__FROM=Arcade <onboarding@resend.dev>
RESEND_API_KEY=
