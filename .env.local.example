# Docker Compose
COMPOSE_PROJECT_NAME=arcade-local
COMPOSE_PROFILES=local
IMAGE_TAG=local
DATA_PATH=./data
PUBLISH_HOST=127.0.0.1
HTTP_PORT=80
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
SITE_ADDR=http://crewon.localhost

# Backend runtime
SPRING_PROFILES_ACTIVE=local
TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# PostgreSQL container
POSTGRES_DB=arcade
POSTGRES_USER=arcade
POSTGRES_PASSWORD=arcade

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/arcade
SPRING_DATASOURCE_USERNAME=arcade
SPRING_DATASOURCE_PASSWORD=arcade
SPRING_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=10
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=30000

# Redis container and Spring client
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=arcade

# GitHub OAuth
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_ID=changeme
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_SECRET=changeme

# Application security
CUSTOM__JWT__SECRET_KEY=changeme-local-jwt-key-with-at-least-64-characters-before-login-use
PUBLIC_ORIGIN=http://crewon.localhost
CUSTOM__ACCESS_TOKEN__EXPIRATION_SECONDS=900

# GitHub App (기능을 쓰지 않으면 비워 둔다)
CUSTOM__GITHUB__APP__ID=
CUSTOM__GITHUB__APP__SLUG=
CUSTOM__GITHUB__APP__PRIVATE_KEY=
CUSTOM__GITHUB__WEBHOOK__SECRET=

# Logging
LOGGING_LEVEL_COM_BACK=DEBUG
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=TRACE
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_EXTRACT=TRACE
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_TRANSACTION_INTERCEPTOR=TRACE

# Frontend
# Dockerfile 이 PUBLIC_ORIGIN/api/v1 을 브라우저 API 주소로 빌드한다.
NEXT_PUBLIC_USE_MOCK=false
API_BASE_URL_INTERNAL=http://backend:8080/api/v1
