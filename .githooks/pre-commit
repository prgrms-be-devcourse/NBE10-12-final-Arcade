#!/bin/sh

# secrets
STAGED_DIFF=$(git diff --cached)

# aws
STRICT="(AKIA[A-Z0-9]{16})|"
# github token
STRICT="${STRICT}gh[pousr]_[A-Za-z0-9]{36,}|"
# .pem, .key
STRICT="${STRICT}(-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----)"

LOOSE="(password|secret|api[_-]?key)[a-z_]*[[:space:]]*[:=][[:space:]]*[\"']?[^\"'[:space:]\${<][^\"'[:space:]]{5,}"

ALLOW='\$\{|process\.env|System\.getenv|getenv\(|\(\)|your[_-]|[_-]here|changeme|placeholder|example|xxxx'

FOUND=$(
  echo "$STAGED_DIFF" | grep -Ei "$STRICT"
  echo "$STAGED_DIFF" | grep -Ei "$LOOSE" | grep -vEi "$ALLOW"
)

if [ -n "$FOUND" ]; then
  echo "커밋에 민감정보로 의심되는 값이 포함돼 있습니다:"
  echo "$FOUND"
  exit 1
fi

# env file
STAGED=$(git diff --cached --name-only)

CANDIDATES=$(echo "$STAGED" | grep -E '(^|/)\.env(\.[A-Za-z0-9_-]+)*$')

# 접미사(example/sample/template)는 제외, 예시).env.example
DANGEROUS=$(echo "$CANDIDATES" | grep -vE '\.(example|sample|template)$')

if [ -n "$DANGEROUS" ]; then
  echo "커밋하면 안 되는 .env 파일이 있습니다:"
  echo "$DANGEROUS"
  exit 1
fi

exit 0
