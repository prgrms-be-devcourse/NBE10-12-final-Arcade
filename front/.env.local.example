# 로컬에서 pnpm dev 로 실행할 때 쓰는 값이다. 복사해서 .env.local 로 쓴다.
#   cp .env.local.example .env.local
#
# .env.local 은 .gitignore 대상이라 커밋되지 않는다.
# 도커로 띄울 때는 이 파일이 아니라 루트 docker-compose.yml 이 값을 넘긴다.

# ---------- 브라우저가 부르는 주소 ----------
# NEXT_PUBLIC_ 접두사가 붙은 것은 빌드 시점에 번들로 인라인된다.
# 값을 바꾸면 dev 서버를 재시작해야 하고, 도커라면 이미지를 다시 빌드해야 한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 데모 데이터 사용 여부.
# 명시한 값이 항상 이긴다. 아무것도 주지 않으면 위 주소 유무로 판단한다.
#   false → 실제 백엔드 호출
#   true  → 주소가 있어도 데모 데이터
NEXT_PUBLIC_USE_MOCK=false

# ---------- 서버(SSR)가 부르는 주소 ----------
# NEXT_PUBLIC_ 접두사가 없다. 번들에 박히지 않고 런타임에 읽힌다.
#
# 컨테이너 안에서는 localhost 가 자기 자신이라 위 주소를 쓸 수 없어서 따로 둔다.
# 호스트에서 pnpm dev 로 돌릴 때는 비워 두면 된다 — 위 공개 주소로 떨어진다.
#
# 도커에서는 루트 docker-compose.yml 이 http://backend:8080/api/v1 로 넣는다.
# API_BASE_URL_INTERNAL=
