      "targets": [
        { "expr": "increase(pg_stat_database_deadlocks{instance=\"$instance\", datname=\"$datname\"}[$__rate_interval])", "legendFormat": "deadlocks", "refId": "A" },
        { "expr": "increase(pg_stat_database_conflicts{instance=\"$instance\", datname=\"$datname\"}[$__rate_interval])", "legendFormat": "conflicts", "refId": "B" }
      ],
      "title": "Deadlocks and conflicts",
      "type": "timeseries"
