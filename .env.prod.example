# Docker Compose
COMPOSE_PROJECT_NAME=arcade-prod
COMPOSE_PROFILES=prod
NGINX_MEM_LIMIT=128m
NGINX_EXPORTER_MEM_LIMIT=64m
NGINX_EXPORTER_GOMEMLIMIT=48MiB
POSTGRES_EXPORTER_MEM_LIMIT=64m
POSTGRES_EXPORTER_GOMEMLIMIT=48MiB
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=NEED_TO_SET
PROMETHEUS_EXTERNAL_URL=https://metrics.crewon.cloud/prometheus
DATA_PATH=/srv/arcade/data
PUBLISH_HOST=127.0.0.1
HTTP_PORT=80
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# 이미지 — CI 가 만든 참조, CD 가 사용, 태그는 짧은 커밋 해시
#   ghcr.io/prgrms-be-devcourse/nbe10-12-final-arcade/backend:<sha>
#   ghcr.io/prgrms-be-devcourse/nbe10-12-final-arcade/frontend:<sha>
BACKEND_IMAGE=NEED_TO_SET
FRONTEND_IMAGE=NEED_TO_SET

# Backend runtime
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
MANAGEMENT_METRICS_TAGS_APPLICATION=back
MANAGEMENT_METRICS_TAGS_ENVIRONMENT=dev
MANAGEMENT_METRICS_TAGS_SERVER=arcade-dev

# PostgreSQL container
POSTGRES_DB=NEED_TO_SET
POSTGRES_USER=NEED_TO_SET
POSTGRES_PASSWORD=NEED_TO_SET

# Spring datasource
SPRING_DATASOURCE_URL=NEED_TO_SET
SPRING_DATASOURCE_USERNAME=NEED_TO_SET
SPRING_DATASOURCE_PASSWORD=NEED_TO_SET
SPRING_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=10
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=30000

# Redis container and Spring client
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=NEED_TO_SET

# GitHub OAuth
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_ID=NEED_TO_SET
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_SECRET=NEED_TO_SET

# Application security
CUSTOM__JWT__SECRET_KEY=NEED_TO_SET
PUBLIC_ORIGIN=https://app.example.com
CUSTOM__ACCESS_TOKEN__EXPIRATION_SECONDS=900

# GitHub App — 연동 기능을 쓸 때만 채운다. 비우면 그 기능만 꺼지고 앱은 뜬다.
# 값을 어디서 얻는지는 docs/github-app.md 의 표를 본다.
CUSTOM__GITHUB__APP__ID=NEED_TO_SET
CUSTOM__GITHUB__APP__SLUG=NEED_TO_SET
# PEM 전체를 한 줄로 넣을 때 줄바꿈은 \\n으로 표현한다.
CUSTOM__GITHUB__APP__PRIVATE_KEY=NEED_TO_SET
CUSTOM__GITHUB__WEBHOOK__SECRET=NEED_TO_SET

# GitHub App 사용자 인증 — 위를 쓸 때만 함께 채운다.
# 우리 로그인(GitHub OAuth App)과는 별개다. 콜백 주소는 GitHub App 설정과 같은 값이어야 한다.
CUSTOM__GITHUB__APP__CLIENT_ID=
CUSTOM__GITHUB__APP__CLIENT_SECRET=
CUSTOM__GITHUB__APP__USER_AUTHORIZATION_CALLBACK_URL=
# openssl rand -base64 32. 사용자 토큰을 복호화하므로 배포 후에 바꾸지 않는다.
CUSTOM__GITHUB__APP__TOKEN_ENCRYPTION_KEY=

# 파일 저장소 (S3)
# 기본값 local 은 컨테이너 안에 쌓여 배포 때마다 사라진다. prod 는 s3 로 둔다.
# 버킷 이름과 URL 접두사는 terraform output 으로 나온다.
#   terraform output uploads_bucket
#   terraform output uploads_public_url_prefix
# 자격증명은 넣지 않는다 — 인스턴스 역할에서 온다.
CUSTOM__STORAGE__TYPE=s3
CUSTOM__STORAGE__S3__REGION=ap-northeast-2
CUSTOM__STORAGE__S3__BUCKET=NEED_TO_SET
CUSTOM__STORAGE__S3__PUBLIC_URL_PREFIX=NEED_TO_SET
CUSTOM__STORAGE__S3__PATH_STYLE_ACCESS=false

# Logging
LOGGING_LEVEL_COM_BACK=INFO
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=OFF
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_EXTRACT=OFF
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_TRANSACTION_INTERCEPTOR=INFO

# Frontend
# 외부 빌드 파이프라인도 PUBLIC_ORIGIN을 build arg로 전달한다.
NEXT_PUBLIC_USE_MOCK=false
API_BASE_URL_INTERNAL=http://backend:8080/api/v1
