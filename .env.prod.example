# 표기: [필수] 반드시 입력, [조건부] 기능 사용 시 입력, [미사용] 이 환경에서는 쓰지 않음

# ---------- Compose 실행 ----------
COMPOSE_PROJECT_NAME=arcade-prod
COMPOSE_PROFILES=prod,monitoring

# ---------- 컨테이너 자원 제한 ----------
NGINX_MEM_LIMIT=128m
REDIS_MAXMEMORY=192mb
REDIS_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=384m
BACKEND_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=256m
# [미사용] Caddy는 local 프로필에서만 실행한다.
CADDY_MEM_LIMIT=64m
# [조건부] monitoring 프로필을 사용할 때만 적용한다.
NGINX_EXPORTER_MEM_LIMIT=64m
NGINX_EXPORTER_GOMEMLIMIT=48MiB
POSTGRES_EXPORTER_MEM_LIMIT=64m
POSTGRES_EXPORTER_GOMEMLIMIT=48MiB

# ---------- PostgreSQL exporter ----------
# [조건부 필수] monitoring 프로필을 사용할 때 필요하다.
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=NEED_TO_SET

# ---------- 모니터링 ----------
# [조건부] monitoring 또는 grafana 서비스를 사용할 때 적용한다.
METRICS_DOMAIN=metrics.crewon.cloud
PROMETHEUS_EXTERNAL_URL=https://metrics.crewon.cloud/prometheus
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=7d
PROMETHEUS_MEM_LIMIT=256m
GRAFANA_MEM_LIMIT=384m
GRAFANA_GOMEMLIMIT=320MiB
GF_SECURITY_ADMIN_USER=admin
# [조건부 필수] Grafana를 실행할 때 관리자 비밀번호를 반드시 교체한다.
GF_SECURITY_ADMIN_PASSWORD=NEED_TO_SET
GF_AUTH_ANONYMOUS_ENABLED=false
PROMETHEUS_URL=http://prometheus:9090/prometheus

# ---------- 경로·포트·프록시 ----------
# [미사용] 아래 두 항목은 local Caddy에서만 사용한다.
CADDYFILE=./infra/caddy/Caddyfile.monitoring
MONITORING_HTTP_PORT=8081
DATA_PATH=/opt/arcade/data
PUBLISH_HOST=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
# frontend를 2개로 겹쳐 띄울 때 호스트 포트 충돌이 없도록 임의 포트를 받는다.
FRONTEND_HOST_PORT=0
# [미사용] local Caddy에서만 사용한다.
SITE_ADDR=https://crewon.cloud
# [필수] prod Nginx의 인증서와 모니터링 Basic Auth 파일 경로다.
CERTBOT_WEBROOT=/opt/arcade/data/certbot/www
CERTBOT_CONF=/opt/arcade/data/certbot/conf
METRICS_HTPASSWD=/opt/arcade/data/nginx/metrics.htpasswd
METRICS_BASIC_AUTH_USER=NEED_TO_SET
METRICS_BASIC_AUTH_PASSWORD=NEED_TO_SET

# ---------- 애플리케이션 이미지 ----------
# 이미지 — CI 가 만든 참조, CD 가 사용, 태그는 짧은 커밋 해시
#   ghcr.io/prgrms-be-devcourse/nbe10-12-final-arcade/backend:<sha>
#   ghcr.io/prgrms-be-devcourse/nbe10-12-final-arcade/frontend:<sha>
BACKEND_IMAGE=NEED_TO_SET
FRONTEND_IMAGE=NEED_TO_SET

# ---------- Backend runtime ----------
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
MANAGEMENT_METRICS_TAGS_APPLICATION=back
MANAGEMENT_METRICS_TAGS_ENVIRONMENT=dev
MANAGEMENT_METRICS_TAGS_SERVER=arcade-dev

# ---------- PostgreSQL container ----------
POSTGRES_DB=NEED_TO_SET
POSTGRES_USER=NEED_TO_SET
POSTGRES_PASSWORD=NEED_TO_SET

# ---------- Spring datasource ----------
SPRING_DATASOURCE_URL=NEED_TO_SET
SPRING_DATASOURCE_USERNAME=NEED_TO_SET
SPRING_DATASOURCE_PASSWORD=NEED_TO_SET
SPRING_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=10
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=30000

# ---------- Redis container and Spring client ----------
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=NEED_TO_SET

# ---------- GitHub OAuth ----------
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_ID=NEED_TO_SET
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_SECRET=NEED_TO_SET

# ---------- Application security ----------
CUSTOM__JWT__SECRET_KEY=NEED_TO_SET
CUSTOM__ADMIN_ACCOUNT__EMAIL=NEED_TO_SET
CUSTOM__ADMIN_ACCOUNT__PASSWORD=NEED_TO_SET
CUSTOM__ADMIN_ACCOUNT__NICKNAME=관리자
PUBLIC_ORIGIN=https://app.example.com
CUSTOM__ACCESS_TOKEN__EXPIRATION_SECONDS=900

# ---------- GitHub App ----------
# [조건부] 연동 기능을 쓸 때만 채운다. 비우면 그 기능만 꺼지고 앱은 뜬다.
# 값을 어디서 얻는지는 docs/github-app.md 의 표를 본다.
CUSTOM__GITHUB__APP__ID=
CUSTOM__GITHUB__APP__SLUG=
# PEM 전체를 한 줄로 넣을 때 줄바꿈은 \\n으로 표현한다.
CUSTOM__GITHUB__APP__PRIVATE_KEY=
CUSTOM__GITHUB__WEBHOOK__SECRET=

# ---------- GitHub App 사용자 인증 ----------
# [조건부] 위 GitHub App 연동을 쓸 때만 함께 채운다. 아니면 모두 비워 둔다.
# 우리 로그인(GitHub OAuth App)과는 별개다. 콜백 주소는 GitHub App 설정과 같은 값이어야 한다.
CUSTOM__GITHUB__APP__CLIENT_ID=
CUSTOM__GITHUB__APP__CLIENT_SECRET=
CUSTOM__GITHUB__APP__USER_AUTHORIZATION_CALLBACK_URL=
# openssl rand -base64 32. 사용자 토큰을 복호화하므로 배포 후에 바꾸지 않는다.
CUSTOM__GITHUB__APP__TOKEN_ENCRYPTION_KEY=

# ---------- 파일 저장소 ----------
# 기본값 local 은 컨테이너 안에 쌓여 배포 때마다 사라진다. prod 는 s3 로 둔다.
# 버킷 이름과 URL 접두사는 terraform output 으로 나온다.
#   terraform output uploads_bucket
#   terraform output uploads_public_url_prefix
# [미사용] TYPE=s3이면 LOCAL__PATH는 사용하지 않는다.
# [선택] AWS S3 기본 endpoint를 쓰면 ENDPOINT는 비워 둔다.
# [비움] ACCESS_KEY와 SECRET_KEY는 넣지 않는다. EC2 IAM 역할에서 임시 자격증명을 얻는다.
CUSTOM__STORAGE__TYPE=s3
CUSTOM__STORAGE__LOCAL__PATH=.uploads
CUSTOM__STORAGE__S3__ENDPOINT=
CUSTOM__STORAGE__S3__REGION=ap-northeast-2
# [필수] Terraform output에서 받은 버킷 이름을 입력한다.
CUSTOM__STORAGE__S3__BUCKET=NEED_TO_SET
CUSTOM__STORAGE__S3__ACCESS_KEY=
CUSTOM__STORAGE__S3__SECRET_KEY=
# [필수] Terraform output에서 받은 공개 URL 접두사를 입력한다.
CUSTOM__STORAGE__S3__PUBLIC_URL_PREFIX=NEED_TO_SET
CUSTOM__STORAGE__S3__PATH_STYLE_ACCESS=false

# ---------- Logging ----------
LOGGING_LEVEL_COM_BACK=INFO
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=OFF
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_EXTRACT=OFF
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_TRANSACTION_INTERCEPTOR=INFO

# ---------- Frontend ----------
# 브라우저 API는 동일 출처 `/api/v1`, SSR만 아래 런타임 주소를 사용한다.
NEXT_PUBLIC_USE_MOCK=false
# SSR도 Nginx가 선택한 활성 backend를 사용한다. 8081은 Docker 네트워크 내부 전용이다.
API_BASE_URL_INTERNAL=http://nginx:8081/api/v1

# ---------- Resend 메일 ----------
# [조건부] MAIL__ENABLED=false면 FROM과 API_KEY를 사용하지 않는다.
# 활성화할 때는 Resend에서 검증한 도메인의 발신 주소와 API key를 입력한다.
CUSTOM__MAIL__ENABLED=false
CUSTOM__MAIL__FROM=Arcade <onboarding@resend.dev>
RESEND_API_KEY=
