# Docker Compose
COMPOSE_PROJECT_NAME=arcade-prod
COMPOSE_PROFILES=prod
IMAGE_TAG=NEED_TO_SET
DATA_PATH=/srv/arcade/data
PUBLISH_HOST=127.0.0.1
HTTP_PORT=80
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Backend runtime
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# PostgreSQL container
POSTGRES_DB=NEED_TO_SET
POSTGRES_USER=NEED_TO_SET
POSTGRES_PASSWORD=NEED_TO_SET

# Spring datasource
SPRING_DATASOURCE_URL=NEED_TO_SET
SPRING_DATASOURCE_USERNAME=NEED_TO_SET
SPRING_DATASOURCE_PASSWORD=NEED_TO_SET
SPRING_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=10
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=30000

# Redis container and Spring client
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=NEED_TO_SET

# GitHub OAuth
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_ID=NEED_TO_SET
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_SECRET=NEED_TO_SET

# Application security
CUSTOM__JWT__SECRET_KEY=NEED_TO_SET
PUBLIC_ORIGIN=https://app.example.com
CUSTOM__ACCESS_TOKEN__EXPIRATION_SECONDS=900

# GitHub App
CUSTOM__GITHUB__APP__ID=NEED_TO_SET
CUSTOM__GITHUB__APP__SLUG=NEED_TO_SET
# PEM 전체를 한 줄로 넣을 때 줄바꿈은 \\n으로 표현한다.
CUSTOM__GITHUB__APP__PRIVATE_KEY=NEED_TO_SET
CUSTOM__GITHUB__WEBHOOK__SECRET=NEED_TO_SET

# Logging
LOGGING_LEVEL_COM_BACK=INFO
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=OFF
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_EXTRACT=OFF
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_TRANSACTION_INTERCEPTOR=INFO

# Frontend
# 외부 빌드 파이프라인도 PUBLIC_ORIGIN을 build arg로 전달한다.
NEXT_PUBLIC_USE_MOCK=false
API_BASE_URL_INTERNAL=http://backend:8080/api/v1
