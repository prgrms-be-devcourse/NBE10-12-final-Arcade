SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_ID=NEED_TO_SET
SPRING__SECURITY__OAUTH2__CLIENT__REGISTRATION__GITHUB__CLIENT_SECRET=NEED_TO_SET

CUSTOM__JWT__SECRET_KEY=NEED_TO_SET

# IDE에서 local 프로필로 실행할 때 필요한 PostgreSQL·Redis·CORS 설정입니다.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/arcade
SPRING_DATASOURCE_USERNAME=arcade
SPRING_DATASOURCE_PASSWORD=arcade
SPRING_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=10
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=30000
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=arcade
CUSTOM__CORS__ALLOWED_ORIGINS=http://localhost:3000

# 초기 관리자 계정입니다. 운영에서는 반드시 별도 값으로 교체합니다.
CUSTOM__ADMIN_ACCOUNT__EMAIL=admin@test.com
CUSTOM__ADMIN_ACCOUNT__PASSWORD=NEED_TO_SET
CUSTOM__ADMIN_ACCOUNT__NICKNAME=관리자

# GitHub App 설치 완료 후 이동할 프론트엔드 주소입니다.
# GitHub App 설치 완료 후 이동 및 비밀번호 재설정 메일 링크에 사용할 프론트엔드 주소입니다.
# 배포 환경에서는 실제 프론트엔드 HTTPS 주소를 설정합니다.
# 예: http://localhost:3000 또는 https://app.example.com
CUSTOM__FRONTEND__BASE_URL=http://localhost:3000

# GitHub App 설정
CUSTOM__GITHUB__APP__ID=NEED_TO_SET
CUSTOM__GITHUB__APP__SLUG=NEED_TO_SET
# GitHub App 설정의 Client ID / Client Secret입니다. 다음 단계의 App user authorization에 사용합니다.
CUSTOM__GITHUB__APP__CLIENT_ID=NEED_TO_SET
CUSTOM__GITHUB__APP__CLIENT_SECRET=NEED_TO_SET
# GitHub App의 "Request user authorization (OAuth)" callback URL입니다.
CUSTOM__GITHUB__APP__USER_AUTHORIZATION_CALLBACK_URL=https://api.example.com/api/v1/github-app/user/callback
# GitHub App user access/refresh token 암호화용 32-byte Base64 키입니다.
# 예: openssl rand -base64 32
CUSTOM__GITHUB__APP__TOKEN_ENCRYPTION_KEY=NEED_TO_SET

# PEM 전체를 한 줄로 넣을 때 줄바꿈은 \\n으로 표현합니다.
# PEM 파일은 github apps에서 'Generate a private key' 버튼을 누르면 다운로드 받아지고, 아래 명령어를 이용하여 한 줄로 만들 수 있습니다.
# awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' {다운로드 된 파일}.pem
CUSTOM__GITHUB__APP__PRIVATE_KEY=NEED_TO_SET

# GitHub App webhook 서명 검증용 임의 문자열입니다. GitHub App 설정 화면의 Webhook secret에도 같은 값을 입력합니다.
# 예: openssl rand -hex 32
CUSTOM__GITHUB__WEBHOOK__SECRET=NEED_TO_SET

# 로컬 webhook 테스트:
# 1) 백엔드를 8080 포트로 실행한 뒤 `ngrok http 8080`을 실행합니다.
# 2) 출력된 HTTPS 주소가 https://abc.ngrok-free.app이면 GitHub App 설정에 아래 URL을 입력합니다.
#    Webhook URL: https://abc.ngrok-free.app/api/v1/github/webhook
#    Setup URL:   https://abc.ngrok-free.app/api/v1/github-app/setup
# 3) ngrok은 실행 중인 터미널에서 Ctrl+C로 종료합니다. 무료 임시 URL은 재시작 시 바뀔 수 있습니다.
# 운영에서는 ngrok 대신 배포 API의 HTTPS 도메인을 위 두 URL에 사용합니다.

# 비밀번호 정책 및 재설정 요청 제한
# 아래 값은 선택 사항입니다. 설정하지 않으면 application.yaml의 기본값이 적용됩니다.
# 기본 정책: 8~64자, 영문자·숫자·특수문자 각각 포함, 공백 불가
CUSTOM__PASSWORD__MIN_LENGTH=8
CUSTOM__PASSWORD__MAX_LENGTH=64
CUSTOM__PASSWORD__REQUIRE_LETTER=true
CUSTOM__PASSWORD__REQUIRE_NUMBER=true
CUSTOM__PASSWORD__REQUIRE_SPECIAL_CHARACTER=true
CUSTOM__PASSWORD__ALLOW_WHITESPACE=false
# 비밀번호 재설정 링크 유효 시간(초): 기본 30분
CUSTOM__PASSWORD_RESET__EXPIRATION_SECONDS=1800
# 재설정 이메일 요청 제한: 기본 이메일당 3회/시간, IP당 10회/시간
CUSTOM__RATE_LIMIT__PASSWORD_RESET_REQUEST__EMAIL_MAX_REQUESTS=3
CUSTOM__RATE_LIMIT__PASSWORD_RESET_REQUEST__IP_MAX_REQUESTS=10
CUSTOM__RATE_LIMIT__PASSWORD_RESET_REQUEST__WINDOW_SECONDS=3600
# 최소안: 비밀번호 변경 후 refresh token만 폐기하고 access token은 만료까지 유지
CUSTOM__SESSION__ACCESS_TOKEN_INVALIDATION=refresh-token-only

# Resend 메일 발송 설정
# Resend API Keys에서 발급한 Sending access 키를 사용한다. 저장소에 커밋하지 않는다.
RESEND_API_KEY=NEED_TO_SET
# 로컬 발송 테스트 시 true로 설정한다. API 키가 없으면 애플리케이션 시작이 실패한다.
CUSTOM__MAIL__ENABLED=false
# 로컬 테스트 기본값은 onboarding@resend.dev이다. 배포에서는 Resend에서 검증한 도메인의 주소로 변경한다.
CUSTOM__MAIL__FROM=Arcade <onboarding@resend.dev>
